{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/proxy-download", "destination": "/api/proxy" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/speedtest", "destination": "/api/index" },
    { "source": "/api/playlist", "destination": "/api/index" },
    { "source": "/api/resolve", "destination": "/api/index" },
    { "source": "/api/extract-hitube", "destination": "/api/index" },
    { "source": "/api/extract", "destination": "/api/index" },
    { "source": "/api/proxy-meta", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
